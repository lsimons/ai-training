{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "coverage", "playwright-report", "test-results"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@scripts/*": ["src/scripts/*"],
      "@lib/*": ["src/lib/*"]
    },
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
    // exactOptionalPropertyTypes is deliberately not set: Astro passes an
    // absent optional prop as `undefined`, which fails six CheckpointShell prop
    // checks under that flag (docs/agents/testing.md, "Lint notes").
  }
}
