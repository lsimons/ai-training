---
/**
 * The topic map (spec S02 "Rendering rules"): every topic from the YAML,
 * one column per area, colored by the state of the lessons that cover it.
 * Prerequisite edges are drawn client-side from the box positions.
 */
import { getCollection } from 'astro:content';
import { getAreas } from '@lib/areas';
import { getAllCoursePlans } from '@lib/courses';
import { jsonForScript } from '@lib/json';
import { getLessons } from '@lib/lessons';
import { href } from '@lib/url';

const topics = (await getCollection('topics')).map((t) => t.data);
const lessons = await getLessons();
// Topics a course plan covers with a lesson that isn't live yet (spec S02 "Storage").
const planned = new Set((await getAllCoursePlans()).filter((e) => e.status !== 'live').map((e) => e.covers));
const byArea = (await getAreas()).map((a) => {
	const list = topics.filter((t) => t.area === a.slug);
	// Order by prerequisite depth within the area, then by name.
	const depth = new Map<string, number>();
	const visit = (id: string, seen: Set<string>): number => {
		if (depth.has(id)) return depth.get(id)!;
		if (seen.has(id)) return 0;
		seen.add(id);
		const t = list.find((x) => x.id === id);
		const local = (t?.links.prerequisites ?? []).filter((p) => list.some((x) => x.id === p));
		const d = local.length ? Math.max(...local.map((p) => visit(p, seen))) + 1 : 0;
		depth.set(id, d);
		return d;
	};
	for (const t of list) visit(t.id, new Set());
	list.sort((x, y) => depth.get(x.id)! - depth.get(y.id)! || x.name.localeCompare(y.name));
	return { area: a, topics: list };
});
const coverage = topics.map((t) => ({
	id: t.id,
	lessons: lessons.filter((l) => l.data.covers === t.id).map((l) => l.id),
}));
const edges = topics.flatMap((t) =>
	t.links.prerequisites.map((from) => ({ from, to: t.id, cross: from.split('/')[0] !== t.area })),
);
---

<div class="not-content">
	<p class="topic-legend">
		<span data-k="none">no lesson planned</span>
		<span data-k="planned">lesson coming</span>
		<span data-k="untouched">has a lesson</span>
		<span data-k="in-progress">in progress</span>
		<span data-k="finished">finished</span>
		<span>solid line: prerequisite within an area; dotted: across areas</span>
	</p>
	<div class="topic-map" data-topic-map data-coverage={JSON.stringify(coverage)}>
		<svg class="topic-map-edges" aria-hidden="true"></svg>
		{
			byArea.map(({ area, topics }) => (
				<div class="topic-col">
					<p class="topic-col-title">{area.name}</p>
					{topics.map((t) => (
						<a class="topic-node" href={href(`/topics/${t.id}/`)} data-topic={t.id} data-state="untouched" data-has-lesson={String(coverage.find((c) => c.id === t.id)!.lessons.length > 0)} data-planned={String(planned.has(t.id))} title={t.definition}>
							{t.name}
						</a>
					))}
				</div>
			))
		}
		<script is:inline type="application/json" data-edges set:html={jsonForScript(edges)} />
	</div>
</div>

<script>
	import * as progress from '@scripts/progress';

	const root = document.querySelector<HTMLElement>('[data-topic-map]');
	if (root) {
		const coverage: { id: string; lessons: string[] }[] = JSON.parse(root.dataset.coverage!);
		function draw() {
			const rec = progress.load();
			for (const c of coverage) {
				const states = c.lessons.map((l) => rec.lessons[l]?.state);
				const state = c.lessons.length && states.every((s) => s === 'finished' || s === 'skipped') ? 'finished' : states.some(Boolean) ? 'in-progress' : 'untouched';
				const el = root!.querySelector<HTMLElement>(`[data-topic="${c.id}"]`);
				if (el) el.dataset.state = state;
			}
		}
		function drawEdges() {
			const svg = root!.querySelector<SVGSVGElement>('.topic-map-edges');
			const raw = root!.querySelector('[data-edges]')?.textContent;
			if (!svg || !raw) return;
			const edges: { from: string; to: string; cross: boolean }[] = JSON.parse(raw);
			const box = root!.getBoundingClientRect();
			svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			svg.innerHTML = edges
				.map((e) => {
					const a = root!.querySelector(`[data-topic="${e.from}"]`)?.getBoundingClientRect();
					const b = root!.querySelector(`[data-topic="${e.to}"]`)?.getBoundingClientRect();
					if (!a || !b) return '';
					const sameCol = Math.abs(a.left - b.left) < 2;
					const x1 = sameCol ? a.left + a.width / 2 - box.left : (a.left < b.left ? a.right : a.left) - box.left;
					const y1 = sameCol ? a.bottom - box.top : a.top + a.height / 2 - box.top;
					const x2 = sameCol ? b.left + b.width / 2 - box.left : (a.left < b.left ? b.left : b.right) - box.left;
					const y2 = sameCol ? b.top - box.top : b.top + b.height / 2 - box.top;
					const mx = (x1 + x2) / 2;
					const d = sameCol ? `M${x1},${y1} L${x2},${y2}` : `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
					return `<path d="${d}" data-cross="${e.cross}" />`;
				})
				.join('');
		}
		draw();
		drawEdges();
		document.addEventListener(progress.EVENT, draw);
		window.addEventListener('resize', drawEdges);
	}
</script>
