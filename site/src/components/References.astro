---
/**
 * The References list of a page whose text the data tree holds, with the
 * markup remark-citations.mjs emits for a lesson page (`ol.references`,
 * `li#ref-N`) and the entry format both get from `referenceParts` in
 * plugins/citation-syntax.mjs. Renders nothing when nothing cited.
 */
import { type Reference, referenceHtml } from '@lib/citations';

interface Props {
	references: Reference[];
}

const { references } = Astro.props;
---

{
	references.length > 0 && (
		<>
			<h2 id="references">References</h2>
			<ol class="references">
				{references.map(({ n, key, entry }) => <li id={`ref-${n}`} set:html={referenceHtml(key, entry)} />)}
			</ol>
		</>
	)
}
