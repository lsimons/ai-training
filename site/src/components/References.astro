---
/**
 * The References list of a page whose text the data tree holds, with the
 * markup remark-citations.mjs emits for a lesson page (`ol.references`,
 * `li#ref-N`, the same entry format). Renders nothing when nothing cited.
 */
import type { Reference } from '@lib/citations';

interface Props {
	references: Reference[];
}

const { references } = Astro.props;
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

{
	references.length > 0 && (
		<>
			<h2 id="references">References</h2>
			<ol class="references">
				{references.map(({ n, key, entry }) => (
					<li id={`ref-${n}`}>
						{entry.author && `${entry.author}. `}
						{entry.url ? <a href={entry.url}><em>{entry.title}</em></a> : <em>{entry.title}</em>}.
						{entry.container && entry.container !== entry.title && ` ${entry.container}.`}
						{` ${capitalize(entry.type)}. `}
						<code>{key}</code>
					</li>
				))}
			</ol>
		</>
	)
}
