---
/**
 * The `/reference/` page body (spec S02 "Learner's reference"): the learner's
 * finished lessons grouped by area, each linking to the topic page that holds
 * its takeaways and example. The catalog is embedded at build; the script
 * reads the progress record and draws the list, or the empty state.
 */
import { getCollection } from 'astro:content';
import { getAreas } from '@lib/areas';
import { getLessons } from '@lib/lessons';
import { href } from '@lib/url';
import type { ReferenceArea } from '@scripts/reference';

const topics = (await getCollection('topics')).map((t) => t.data);
const lessons = await getLessons();
const catalog: ReferenceArea[] = (await getAreas()).map((a) => ({
	area: a.slug,
	title: a.name,
	lessons: lessons
		.filter((l) => l.id.startsWith(`${a.slug}/`))
		.map((l) => ({
			id: l.id,
			title: l.data.title,
			topics: [l.data.covers].map((id) => ({ id, name: topics.find((t) => t.id === id)?.name ?? id })),
		})),
}));
---

<div class="not-content learners-reference" data-learners-reference data-catalog={JSON.stringify(catalog)} data-base={href('/')}>
	<p class="reference-empty" data-reference-empty hidden>
		Nothing here yet. Finish a lesson and its takeaways and example appear on the topic page it covers, and the lesson
		is listed here. <a href={href('/progress/')}>Your progress</a> shows where you are.
	</p>
	<div data-reference-areas></div>
</div>

<script>
	import { mountLearnersReference } from '@scripts/learners-reference';

	mountLearnersReference(document);
</script>
