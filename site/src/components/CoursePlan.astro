---
/**
 * The course plan (spec S11) as one read-only table under the lesson graph,
 * folded into a `<details>` so the graph stays first. One row per lesson in
 * course order, with a heading row per part when the course has parts. The
 * `notes` fields never render; read the YAML for those.
 */
import { getCollection } from 'astro:content';
import { afterTitles, exerciseKinds, idTail, issueUrl, objectiveCells, planSummary } from '@lib/course-plan-table';
import { getCourse, isLive, type PlanEntry } from '@lib/courses';
import { href } from '@lib/url';

interface Props {
	area: string;
}
const { area } = Astro.props;
const course = await getCourse(area);
const plan = course.entries;
const competencies = (await getCollection('competencies')).map((c) => c.data);
const groups: { title: string | undefined; lessons: PlanEntry[] }[] = course.parts
	? course.parts.map((p) => ({ title: p.title, lessons: p.lessons }))
	: [{ title: undefined, lessons: plan }];
let n = 0;
---

<details class="course-plan not-content" data-course-plan={area}>
	<summary>{planSummary(plan)}</summary>
	<table aria-label={planSummary(plan)}>
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Lesson</th>
				<th scope="col">Status</th>
				<th scope="col">Mode</th>
				<th scope="col">Minutes</th>
				<th scope="col">Covers</th>
				<th scope="col">Serves</th>
				<th scope="col">Exercise</th>
				<th scope="col">After</th>
				<th scope="col">Issue</th>
			</tr>
		</thead>
		{
			groups.map((g) => (
				<tbody>
					{g.title && (
						<tr class="course-plan-part" data-plan-part={g.title}>
							<th scope="rowgroup" colspan="10">{g.title}</th>
						</tr>
					)}
					{g.lessons.map((e) => {
						const issue = issueUrl(e.issue);
						n += 1;
						return (
							<tr data-plan-entry={e.id} data-status={e.status}>
								<td>{n}</td>
								<td>
									{isLive(e) ? <a href={href(`/${e.id}/`)}>{e.title}</a> : e.title}
									<small class="course-plan-id">{e.id}</small>
								</td>
								<td>{e.status}</td>
								<td>{e.mode}</td>
								<td>{e.minutes}</td>
								<td>
									<a href={href(`/topics/${e.covers}/`)} title={e.covers}>{idTail(e.covers)}</a>
								</td>
								<td>
									{objectiveCells(e.serves, competencies).map((o) =>
										o.path ? (
											<a class="course-plan-objective" href={href(o.path)} title={o.id}>{o.tail}</a>
										) : (
											<span class="course-plan-objective" title={o.id}>{o.tail}</span>
										)
									)}
								</td>
								<td>{exerciseKinds(e)}</td>
								<td>{afterTitles(e.after, plan).join(', ')}</td>
								<td>{issue && <a href={issue}>#{e.issue}</a>}</td>
							</tr>
						);
					})}
				</tbody>
			))
		}
	</table>
</details>
