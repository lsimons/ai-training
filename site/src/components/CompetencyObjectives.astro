---
/**
 * The objectives of one competency page (spec S02 "Stable URLs"): each
 * objective's behaviors table (cells already rendered as HTML by
 * lib/citations `renderObjectives`) and the lessons serving it. The page
 * owns the citation numbering and renders the References list last.
 */
import type { Objective } from '@lib/citations';
import { getLessons } from '@lib/lessons';
import { href } from '@lib/url';

interface Props {
	objectives: Objective[];
}

const { objectives } = Astro.props;
const lessons = await getLessons();
const serving = (objectiveId: string) => lessons.filter((l) => l.data.serves.includes(objectiveId));
---

{
	objectives.map((o) => (
		<section>
			<h3 id={o.id.split('/').pop()}>{o.statement} <small>({o.level})</small></h3>
			{o.behaviors.length ? (
				<table>
					<thead><tr><th>Claim</th><th>Why</th><th>Example</th></tr></thead>
					<tbody>{o.behaviors.map((b) => <tr><td set:html={b.claim} /><td set:html={b.why} /><td set:html={b.example} /></tr>)}</tbody>
				</table>
			) : (
				<p><em>Behaviors not written yet.</em></p>
			)}
			{serving(o.id).length ? (
				<p>Served by: {serving(o.id).map((l, i) => (<>{i > 0 && ', '}<a href={href(`/${l.id}/`)}>{l.data.title}</a></>))}</p>
			) : (
				<p>No lesson serves this objective yet.</p>
			)}
		</section>
	))
}
