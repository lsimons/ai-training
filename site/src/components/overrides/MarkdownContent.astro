---
import { getCollection, render } from 'astro:content';
/**
 * Starlight `MarkdownContent` override. For lesson pages (frontmatter has
 * `mode`) it wraps the content in a lesson frame carrying the ids the client
 * needs, renders the routing cards (spec S02 "Differentiation by routing"),
 * and loads the lesson script once. The comfort level that drives the
 * routing is set on the settings page. Other pages render as Starlight does.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { ENGINEERING_AREAS } from '@lib/areas';
import { knownPagePaths } from '@lib/links';
import { href } from '@lib/url';

const entry = Astro.locals.starlightRoute.entry;
const data = entry.data as typeof entry.data & {
	mode?: string;
	serves?: string[];
	assumes?: { objective: string; lesson: string; section: string }[];
	'extends-to'?: { label: string; href: string }[];
};
const isLesson = Boolean(data.mode);
const lessonId = entry.id;
const area = lessonId.split('/')[0] ?? '';
const engineering = ENGINEERING_AREAS.includes(area);

let behind: { objective: string; statement: string; href: string; lessonTitle: string }[] = [];
let ahead: { label: string; href: string; exists: boolean }[] = [];
if (isLesson) {
	const docs = await getCollection('docs');
	const competencies = await getCollection('competencies');
	const statements = new Map<string, string>();
	for (const a of competencies)
		for (const c of a.data.competencies) for (const o of c.objectives) statements.set(o.id, o.statement);
	// `assumes[].section` must be a `## ` heading of the target lesson. The slugs
	// come from Starlight's own rendering, so they match the anchors it emits.
	const sectionSlugs = new Map<string, string[]>();
	for (const a of data.assumes ?? []) {
		if (sectionSlugs.has(a.lesson)) continue;
		const lesson = docs.find((d) => d.id === a.lesson);
		if (!lesson) throw new Error(`${lessonId}: assumes unknown lesson ${a.lesson}`);
		const { headings } = await render(lesson);
		sectionSlugs.set(
			a.lesson,
			headings.filter((h) => h.depth === 2).map((h) => h.slug),
		);
	}
	behind = (data.assumes ?? []).map((a) => {
		const lesson = docs.find((d) => d.id === a.lesson)!;
		if (!statements.has(a.objective)) throw new Error(`${lessonId}: assumes unknown objective ${a.objective}`);
		const slugs = sectionSlugs.get(a.lesson)!;
		if (!slugs.includes(a.section)) {
			throw new Error(
				`${lessonId}: assumes section "${a.section}" which is not a "## " heading of ${a.lesson}; its sections are: ${slugs.join(', ')}`,
			);
		}
		return {
			objective: a.objective,
			statement: statements.get(a.objective)!,
			href: href(`/${a.lesson}/#${a.section}`),
			lessonTitle: lesson.data.title,
		};
	});
	const pages = await knownPagePaths();
	ahead = (data['extends-to'] ?? []).map((n) => ({
		label: n.label,
		href: href(n.href),
		exists: pages.has(n.href),
	}));
}
---

{
	isLesson ? (
		<div class="lesson" data-lesson={lessonId} data-mode={data.mode} data-area={area} data-engineering={String(engineering)}>
			{behind.length > 0 && (
				<aside class="route-card route-behind not-content" data-route="behind" hidden>
					<p class="route-title">Worth revisiting first</p>
					<ul>
						{behind.map((b) => (
							<li>
								<a href={b.href}>{b.statement}</a> <span class="route-where">in {b.lessonTitle}</span>
							</li>
						))}
					</ul>
				</aside>
			)}
			<Default><slot /></Default>
			{ahead.length > 0 && (
				<aside class="route-card route-ahead not-content" data-route="ahead" hidden>
					<p class="route-title">You are ahead. Next:</p>
					<ul>
						{ahead.map((n) => (
							<li>{n.exists ? <a href={n.href}>{n.label}</a> : <span>{n.label} <span class="route-where">(not written yet)</span></span>}</li>
						))}
					</ul>
				</aside>
			)}
		</div>
	) : (
		<Default><slot /></Default>
	)
}

<script>
	import * as progress from '@scripts/progress';
	import { bindAll } from '@scripts/checkpoints';

	const root = document.querySelector<HTMLElement>('.lesson[data-lesson]');
	if (root) {
		const lessonId = root.dataset.lesson!;
		const checkpoints = bindAll(root, {
			onResult: () => {
				route();
				drawLesson();
			},
		});
		progress.markLessonRead(lessonId);

		// Routing: a failed or skipped checkpoint surfaces the assumed objectives;
		// every checkpoint passed first time surfaces the extensions.
		const behindCard = root.querySelector<HTMLElement>('[data-route=behind]');
		const aheadCard = root.querySelector<HTMLElement>('[data-route=ahead]');
		function route() {
			const rec = progress.load();
			const states = checkpoints.map((el) => rec.checkpoints[el.dataset.progressId!]);
			const anyStuck = states.some((s) => s && s.state !== 'passed');
			const allClean = states.length > 0 && states.every((s) => s?.state === 'passed' && s.attempts === 1);
			if (behindCard) behindCard.hidden = !(anyStuck || rec.comfort === 'less');
			if (aheadCard) aheadCard.hidden = !(allClean || rec.comfort === 'more');
		}

		route();

		// Finish and skip (spec S04 lesson states; finishing schedules reviews, spec S05).
		const finish = root.querySelector<HTMLButtonElement>('[data-finish]');
		const finishNote = root.querySelector<HTMLElement>('[data-finish-note]');
		const skip = root.querySelector<HTMLButtonElement>('[data-skip-lesson]');
		/** `finished` needs every checkpoint passed or skipped (spec S04 "Lesson states"). */
		function openCheckpoints(): number {
			const rec = progress.load();
			return checkpoints.filter((el) => {
				const state = rec.checkpoints[el.dataset.progressId!]?.state;
				return state !== 'passed' && state !== 'skipped';
			}).length;
		}
		function drawLesson() {
			const l = progress.load().lessons[lessonId];
			const open = openCheckpoints();
			if (finish) {
				finish.disabled = l?.state === 'finished' || open > 0;
				finish.textContent = l?.state === 'finished' ? `Finished ✓ (${l.at})` : 'Mark lesson finished';
			}
			if (finishNote) {
				finishNote.textContent = l?.state !== 'finished' && open > 0 ? `Pass or skip ${open} more checkpoint${open === 1 ? '' : 's'} to finish this lesson.` : '';
			}
			if (skip) {
				skip.disabled = l?.state === 'skipped' || l?.state === 'finished';
				skip.textContent = l?.state === 'skipped' ? `Skipped (${l.at})` : 'I know this, skip it';
			}
		}
		finish?.addEventListener('click', () => {
			if (openCheckpoints() > 0) return;
			const reviewable = checkpoints
				.filter((el) => el.dataset.reviewable === 'true')
				.map((el) => ({ id: el.dataset.progressId!, revision: Number(el.dataset.revision ?? progress.DEFAULT_REVISION) }));
			progress.finishLesson(lessonId, reviewable);
			drawLesson();
		});
		skip?.addEventListener('click', () => {
			progress.skipLesson(lessonId);
			drawLesson();
		});
		drawLesson();
	}
</script>
