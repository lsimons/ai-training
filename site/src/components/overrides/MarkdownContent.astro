---
/**
 * Starlight `MarkdownContent` override. For lesson pages (frontmatter has
 * `mode`) it wraps the content in a lesson frame carrying the ids the client
 * needs, renders the routing cards (spec S02 "Differentiation by routing"),
 * and loads the lesson script once. The comfort level that drives the
 * routing is set on the settings page. Other pages render as Starlight does.
 */
import { getCollection, render } from 'astro:content';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import ReviewLine from '@components/lesson/ReviewLine.astro';
import RouteAhead, { type AheadItem } from '@components/lesson/RouteAhead.astro';
import TutorBlock from '@components/lesson/TutorBlock.astro';
import { getAreas, isEngineering } from '@lib/areas';
import { checkExtendsToHref } from '@lib/extends-to';
import { checkpointsOf, type Lesson } from '@lib/lessons';
import { bibliographySources, knownPagePaths } from '@lib/links';
import { chooseSkillsCheck } from '@lib/skills-check';
import { absoluteUrl, href } from '@lib/url';

const entry = Astro.locals.starlightRoute.entry;
const data = entry.data as typeof entry.data & {
	mode?: string;
	serves?: string[];
	assumes?: { objective: string; lesson: string; section: string }[];
	'extends-to'?: { label: string; href: string }[];
	'sources-checked'?: Date;
	'review-by'?: Date;
};
const isLesson = Boolean(data.mode);
const lessonId = entry.id;
const area = lessonId.split('/')[0] ?? '';
const engineering = isLesson && isEngineering(await getAreas(), area);

let behind: { objective: string; statement: string; href: string; lessonTitle: string }[] = [];
let ahead: AheadItem[] = [];
// The skills check (spec S04 "Skills check"): one checkpoint per served
// objective, offered to comfort `more` on Engineering lessons. Foundations
// has no comfort levels (spec S01).
let skillsCheck: string[] = [];
if (isLesson) {
	if (engineering) skillsCheck = chooseSkillsCheck(data.serves ?? [], checkpointsOf(entry as Lesson));
	const docs = await getCollection('docs');
	const competencies = await getCollection('competencies');
	const statements = new Map<string, string>();
	for (const c of competencies) for (const o of c.data.objectives) statements.set(o.id, o.statement);
	// `assumes[].section` must be a `## ` heading of the target lesson. The slugs
	// come from Starlight's own rendering, so they match the anchors it emits.
	const sectionSlugs = new Map<string, string[]>();
	// A live lesson's `assumes` entries name the lesson and section that teach the objective (spec S11).
	const assumed = (data.assumes ?? []).map((a) => {
		if (!a.lesson || !a.section) {
			throw new Error(`${lessonId}: assumes ${a.objective} without the lesson and section that teach it`);
		}
		return { objective: a.objective, lesson: a.lesson, section: a.section };
	});
	for (const a of assumed) {
		if (sectionSlugs.has(a.lesson)) continue;
		const lesson = docs.find((d) => d.id === a.lesson);
		if (!lesson) throw new Error(`${lessonId}: assumes unknown lesson ${a.lesson}`);
		const { headings } = await render(lesson);
		sectionSlugs.set(
			a.lesson,
			headings.filter((h) => h.depth === 2).map((h) => h.slug),
		);
	}
	behind = assumed.map((a) => {
		const lesson = docs.find((d) => d.id === a.lesson)!;
		if (!statements.has(a.objective)) throw new Error(`${lessonId}: assumes unknown objective ${a.objective}`);
		const slugs = sectionSlugs.get(a.lesson)!;
		if (!slugs.includes(a.section)) {
			throw new Error(
				`${lessonId}: assumes section "${a.section}" which is not a "## " heading of ${a.lesson}; its sections are: ${slugs.join(', ')}`,
			);
		}
		return {
			objective: a.objective,
			statement: statements.get(a.objective)!,
			href: href(`/${a.lesson}/#${a.section}`),
			lessonTitle: lesson.data.title ?? a.lesson,
		};
	});
	// An `extends-to` href is a root-relative page path, or an `https://` URL under
	// a bibliography `url` (spec S03 "Frontmatter"). Anything else fails the build.
	const pages = await knownPagePaths();
	const sources = await bibliographySources();
	ahead = (data['extends-to'] ?? []).map((n) => {
		const check = checkExtendsToHref(n.href, sources);
		if (check.kind === 'invalid') throw new Error(`${lessonId}: ${check.reason}`);
		const external = check.kind === 'external';
		return { label: n.label, href: n.href, external, exists: external || pages.has(n.href) };
	});
}
---

{
	isLesson ? (
		<div class="lesson" data-lesson={lessonId} data-mode={data.mode} data-area={area} data-engineering={String(engineering)}>
			{skillsCheck.length > 0 && (
				<aside class="route-card skills-check not-content" data-skills-check data-items={skillsCheck.join(' ')} hidden>
					<p class="route-title" data-skills-title>Skip ahead?</p>
					<p class="skills-note" data-skills-note></p>
					<div class="skills-actions">
						<button type="button" class="cp-check" data-skills-start></button>
						<button type="button" data-skills-dismiss>Not now</button>
					</div>
					<div class="skills-items" data-skills-items hidden></div>
				</aside>
			)}
			{behind.length > 0 && (
				<aside class="route-card route-behind not-content" data-route="behind" hidden>
					<p class="route-title">Worth revisiting first</p>
					<ul>
						{behind.map((b) => (
							<li>
								<a href={b.href}>{b.statement}</a> <span class="route-where">in {b.lessonTitle}</span>
							</li>
						))}
					</ul>
				</aside>
			)}
			<ReviewLine reviewBy={data['review-by']} sourcesChecked={data['sources-checked']} />
			<Default><slot /></Default>
			<RouteAhead items={ahead} />
			<TutorBlock lessonUrl={absoluteUrl(`/${lessonId}/`, String(Astro.site))} />
		</div>
	) : (
		<Default><slot /></Default>
	)
}

<script>
	import { openSkillsCheck } from '@lib/skills-check';
	import { skillsCheckNote, skillsCheckOffer } from '@scripts/checkpoint-logic';
	import * as progress from '@scripts/progress';
	import { bindAll, bindCheckpoint, copyForSkillsCheck, drawState } from '@scripts/checkpoints';

	const root = document.querySelector<HTMLElement>('.lesson[data-lesson]');
	if (root) {
		const lessonId = root.dataset.lesson!;

		// Skills check (spec S04 "Skills check"). The copies are taken before
		// `bindAll` so they carry no listeners, no `data-bound` and no shuffle,
		// and inserted after it so the lesson's own list never includes them.
		const skillsCard = root.querySelector<HTMLElement>('[data-skills-check]');
		const skillsItems = skillsCard && progress.load().comfort === 'more' ? skillsCheckItems(skillsCard) : [];
		function skillsCheckItems(card: HTMLElement): { body: HTMLElement; copy: HTMLElement; progressId: string }[] {
			return (card.dataset.items ?? '')
				.split(' ')
				.map((id) => root!.querySelector<HTMLElement>(`[data-checkpoint][id="${id}"]`))
				.filter((el): el is HTMLElement => el !== null)
				.map((body) => ({ body, copy: copyForSkillsCheck(body), progressId: body.dataset.progressId! }));
		}
		/** The skip rule against the record as it is now: a checkpoint passed in the body meanwhile is not asked. */
		const openSkillsItems = () => openSkillsCheck(skillsItems, progress.load().checkpoints);
		let skillsStarted = false;

		const checkpoints = bindAll(root, {
			onResult: () => {
				route();
				drawLesson();
				if (!skillsStarted) offerSkillsCheck();
			},
		});
		progress.markLessonRead(lessonId);

		/** Show the offer with the current open count, or hide the card when nothing is left to ask. */
		function offerSkillsCheck() {
			if (!skillsCard || skillsItems.length === 0) return;
			const open = openSkillsItems().length;
			skillsCard.hidden = open === 0;
			const start = skillsCard.querySelector<HTMLButtonElement>('[data-skills-start]');
			if (start) start.textContent = skillsCheckOffer(open);
		}

		if (skillsCard && skillsItems.length > 0) {
			const note = skillsCard.querySelector<HTMLElement>('[data-skills-note]')!;
			const start = skillsCard.querySelector<HTMLButtonElement>('[data-skills-start]')!;
			const dismiss = skillsCard.querySelector<HTMLButtonElement>('[data-skills-dismiss]')!;
			const items = skillsCard.querySelector<HTMLElement>('[data-skills-items]')!;
			note.textContent =
				'One checkpoint per objective this lesson teaches, one try each. A pass counts as if you answered it in the lesson, and the review schedule picks it up.';
			offerSkillsCheck();

			start.addEventListener('click', () => {
				const asked = openSkillsItems();
				if (asked.length === 0) {
					skillsCard.hidden = true;
					return;
				}
				skillsStarted = true;
				start.hidden = true;
				items.hidden = false;
				const total = asked.length;
				let answered = 0;
				let passed = 0;
				for (const { body, copy } of asked) {
					items.appendChild(copy);
					const reviewable = copy.dataset.reviewable === 'true';
					const revision = Number(copy.dataset.revision ?? progress.DEFAULT_REVISION);
					bindCheckpoint(copy, {
						// One write: the checkpoint result, and on a reviewable pass its review item.
						record: (id, ok) => progress.recordSkillsCheck(id, ok, reviewable ? { id, revision } : undefined),
						onResult: (el, ok) => {
							// One Check per item: the result is recorded, so lock the copy.
							el.querySelector<HTMLButtonElement>('.cp-check')?.setAttribute('disabled', 'true');
							const after = el.querySelector<HTMLElement>('.cp-after');
							if (after) after.hidden = false;
							drawState(body);
							route();
							drawLesson();
							answered++;
							if (ok) passed++;
							note.textContent = skillsCheckNote(answered, passed, total);
							if (answered === total) dismiss.textContent = 'Close';
						},
					});
				}
			});
			dismiss.addEventListener('click', () => {
				skillsCard.hidden = true;
			});
		}

		// Routing: a failed or skipped checkpoint surfaces the assumed objectives;
		// every checkpoint passed first time surfaces the extensions.
		const behindCard = root.querySelector<HTMLElement>('[data-route=behind]');
		const aheadCard = root.querySelector<HTMLElement>('[data-route=ahead]');
		function route() {
			const rec = progress.load();
			const states = checkpoints.map((el) => rec.checkpoints[el.dataset.progressId!]);
			const anyStuck = states.some((s) => s && s.state !== 'passed');
			const allClean = states.length > 0 && states.every((s) => s?.state === 'passed' && s.attempts === 1);
			if (behindCard) behindCard.hidden = !(anyStuck || rec.comfort === 'less');
			if (aheadCard) aheadCard.hidden = !(allClean || rec.comfort === 'more');
		}

		route();

		// Finish and skip (spec S04 lesson states; finishing schedules reviews, spec S05).
		const finish = root.querySelector<HTMLButtonElement>('[data-finish]');
		const finishNote = root.querySelector<HTMLElement>('[data-finish-note]');
		// Two skip buttons: the recap's, and the sidebar tip's when the lesson has `covered-by` (#111).
		const skips = document.querySelectorAll<HTMLButtonElement>('[data-skip-lesson]');
		/** `finished` needs every checkpoint passed or skipped (spec S04 "Lesson states"). */
		function openCheckpoints(): number {
			const rec = progress.load();
			return checkpoints.filter((el) => {
				const state = rec.checkpoints[el.dataset.progressId!]?.state;
				return state !== 'passed' && state !== 'skipped';
			}).length;
		}
		function drawLesson() {
			const l = progress.load().lessons[lessonId];
			const open = openCheckpoints();
			if (finish) {
				finish.disabled = l?.state === 'finished' || open > 0;
				finish.textContent = l?.state === 'finished' ? `Finished ✓ (${l.at})` : 'Mark lesson finished';
			}
			if (finishNote) {
				finishNote.textContent = l?.state !== 'finished' && open > 0 ? `Pass or skip ${open} more checkpoint${open === 1 ? '' : 's'} to finish this lesson.` : '';
			}
			for (const skip of skips) {
				skip.disabled = l?.state === 'skipped' || l?.state === 'finished';
				skip.textContent = l?.state === 'skipped' ? `Skipped (${l.at})` : 'I know this, skip it';
			}
		}
		finish?.addEventListener('click', () => {
			if (openCheckpoints() > 0) return;
			const reviewable = checkpoints
				.filter((el) => el.dataset.reviewable === 'true')
				.map((el) => ({ id: el.dataset.progressId!, revision: Number(el.dataset.revision ?? progress.DEFAULT_REVISION) }));
			progress.finishLesson(lessonId, reviewable);
			drawLesson();
		});
		for (const skip of skips) {
			skip.addEventListener('click', () => {
				progress.skipLesson(lessonId);
				drawLesson();
			});
		}
		drawLesson();
	}
</script>
