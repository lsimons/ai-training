---
/**
 * Starlight `MarkdownContent` override. For lesson pages (frontmatter has
 * `mode`) it wraps the content in a lesson frame carrying the ids the client
 * needs, renders the routing cards (spec S02 "Differentiation by routing"),
 * and loads the lesson script once. The comfort level that drives the
 * routing is set on the settings page. Other pages render as Starlight does.
 */
import { getCollection, render } from 'astro:content';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import RouteAhead, { type AheadItem } from '@components/lesson/RouteAhead.astro';
import TutorBlock from '@components/lesson/TutorBlock.astro';
import { getAreas, isEngineering } from '@lib/areas';
import { checkExtendsToHref } from '@lib/extends-to';
import { checkpointsOf, type Lesson } from '@lib/lessons';
import { bibliographySources, knownPagePaths } from '@lib/links';
import { assumedSectionError } from '@lib/section-slugs';
import { chooseSkillsCheck } from '@lib/skills-check';
import { absoluteUrl, href } from '@lib/url';

const entry = Astro.locals.starlightRoute.entry;
const data = entry.data as typeof entry.data & {
	mode?: string;
	serves?: string[];
	assumes?: { objective: string; lesson: string; section: string }[];
	'extends-to'?: { label: string; href: string }[];
};
const isLesson = Boolean(data.mode);
const lessonId = entry.id;
const area = lessonId.split('/')[0] ?? '';
const engineering = isLesson && isEngineering(await getAreas(), area);

let behind: { objective: string; statement: string; href: string; lessonTitle: string }[] = [];
let ahead: AheadItem[] = [];
// The skills check (spec S04 "Skills check"): one checkpoint per served
// objective, offered to comfort `more` on Engineering lessons. Foundations
// has no comfort levels (spec S01).
let skillsCheck: string[] = [];
if (isLesson) {
	// Only `first` checkpoints are asked: an alternate never stands in for the lesson's own (spec S04).
	if (engineering) skillsCheck = chooseSkillsCheck(data.serves ?? [], checkpointsOf(entry as Lesson));
	const docs = await getCollection('docs');
	const competencies = await getCollection('competencies');
	const statements = new Map<string, string>();
	for (const c of competencies) for (const o of c.data.objectives) statements.set(o.id, o.statement);
	// `assumes[].section` must be a `## ` heading of the target lesson. The slugs
	// come from Starlight's own rendering, so they match the anchors it emits.
	// `mise run data` checks the same rule earlier, and for planned lessons too.
	// Per assumed lesson: its title and the slugs of its `## ` headings.
	const assumedLessons = new Map<string, { title: string; slugs: string[] }>();
	// A live lesson's `assumes` entries name the lesson and section that teach the objective (spec S11).
	const assumed = (data.assumes ?? []).map((a) => {
		if (!a.lesson || !a.section) {
			throw new Error(`${lessonId}: assumes ${a.objective} without the lesson and section that teach it`);
		}
		return { objective: a.objective, lesson: a.lesson, section: a.section };
	});
	for (const a of assumed) {
		if (assumedLessons.has(a.lesson)) continue;
		const lesson = docs.find((d) => d.id === a.lesson);
		if (!lesson) throw new Error(`${lessonId}: assumes unknown lesson ${a.lesson}`);
		const { headings } = await render(lesson);
		assumedLessons.set(a.lesson, {
			title: lesson.data.title ?? a.lesson,
			slugs: headings.filter((h) => h.depth === 2).map((h) => h.slug),
		});
	}
	behind = assumed.map((a) => {
		const statement = statements.get(a.objective);
		if (statement === undefined) throw new Error(`${lessonId}: assumes unknown objective ${a.objective}`);
		const target = assumedLessons.get(a.lesson);
		if (!target) throw new Error(`${lessonId}: assumes unknown lesson ${a.lesson}`);
		const sectionError = assumedSectionError(lessonId, a.lesson, a.section, target.slugs);
		if (sectionError) throw new Error(sectionError);
		return {
			objective: a.objective,
			statement,
			href: href(`/${a.lesson}/#${a.section}`),
			lessonTitle: target.title,
		};
	});
	// An `extends-to` href is a root-relative page path, or an `https://` URL under
	// a bibliography `url` (spec S03 "Frontmatter"). Anything else fails the build.
	const pages = await knownPagePaths();
	const sources = await bibliographySources();
	ahead = (data['extends-to'] ?? []).map((n) => {
		const check = checkExtendsToHref(n.href, sources);
		if (check.kind === 'invalid') throw new Error(`${lessonId}: ${check.reason}`);
		const external = check.kind === 'external';
		return { label: n.label, href: n.href, external, exists: external || pages.has(n.href) };
	});
}
---

{
	isLesson ? (
		<div class="lesson" data-lesson={lessonId} data-mode={data.mode} data-area={area} data-engineering={String(engineering)}>
			{skillsCheck.length > 0 && (
				<aside class="route-card skills-check not-content" data-skills-check data-items={skillsCheck.join(' ')} hidden>
					<p class="route-title" data-skills-title>Skip ahead?</p>
					<p class="skills-note" data-skills-note></p>
					<div class="skills-actions">
						<button type="button" class="cp-check" data-skills-start></button>
						<button type="button" data-skills-dismiss>Not now</button>
					</div>
					<div class="skills-items" data-skills-items hidden></div>
				</aside>
			)}
			{behind.length > 0 && (
				<aside class="route-card route-behind not-content" data-route="behind" hidden>
					<p class="route-title">Worth revisiting first</p>
					<ul>
						{behind.map((b) => (
							<li>
								<a href={b.href}>{b.statement}</a> <span class="route-where">in {b.lessonTitle}</span>
							</li>
						))}
					</ul>
				</aside>
			)}
			<Default><slot /></Default>
			<RouteAhead items={ahead} />
			<TutorBlock lessonUrl={absoluteUrl(`/${lessonId}/`, String(Astro.site))} />
		</div>
	) : (
		<Default><slot /></Default>
	)
}

<script>
	import { mountLesson } from '@scripts/markdown-content';

	mountLesson(document);
</script>
