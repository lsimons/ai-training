---
/**
 * Starlight `Footer` override. Reordered: the previous/next cards come
 * first, right after the content; then one small line with the edit link,
 * one date line, and the AI co-authorship notice every page carries.
 *
 * The date line is the review line ("Sources checked on X. Review due by
 * Y.") on a lesson whose plan sets `review-by` (spec S03 "Frontmatter"), and
 * Starlight's "Last updated" (the page's last git commit) on every other
 * page, so no page shows two dates (issue #274).
 */
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import ReviewLine from '@components/lesson/ReviewLine.astro';

const data = Astro.locals.starlightRoute.entry.data as { 'sources-checked'?: Date; 'review-by'?: Date };
const reviewBy = data['review-by'];
---

<footer class="site-footer">
	<Pagination />
	<div class="site-footer-meta">
		<EditLink />
		{reviewBy ? <ReviewLine reviewBy={reviewBy} sourcesChecked={data['sources-checked']} /> : <LastUpdated />}
		<p class="ai-notice">Content co-authored by AI.</p>
	</div>
</footer>
