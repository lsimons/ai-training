---
/**
 * The sidebar list, in place of Starlight's `SidebarSublist` (issue #228).
 * Starlight's copy renders a group as a `<details>` with a label. This one
 * adds a second kind of group: when the first entry is a link with the
 * `data-group-link` attribute (`lib/sidebar-groups.ts`), that link is the
 * group's heading, so a course page or the topic map is the parent of its
 * children and clicking the heading opens the page. The link sits next to
 * the `<details>`, and the `<summary>` is a caret-only toggle with an
 * `aria-label`: a link inside the summary would be nested interactive
 * content, and Starlight's `SidebarPersistState` script stores an inverted
 * open state for any click that lands on a summary. The `<details>` is
 * `display: contents`, so the link and the caret share one grid row of the
 * `<li>` and the entries fill the row below.
 *
 * Groups under a linked group (a course's parts, the topic map's areas) get
 * a plain label instead of the bold one. The rest of the markup and the
 * styles are Starlight's, kept so the persisted open state and the restore
 * points keep working. `overrides/Sidebar.astro` renders this in place of
 * the default.
 */
import { Badge, Icon } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import { linkedGroup, type SidebarEntry, startsOpen } from '@lib/sidebar-groups';

interface Props {
	sublist: SidebarEntry[];
	nested?: boolean;
	/** Inside a linked group: a nested group's label is plain, so it reads as a child of the heading. */
	plainLabels?: boolean;
}

const { sublist, nested, plainLabels } = Astro.props;
---

<ul class:list={{ 'top-level': !nested }}>
	{
		sublist.map((entry) => {
			if (entry.type === 'link') {
				return (
					<li>
						<a
							href={entry.href}
							aria-current={entry.isCurrent ? 'page' : undefined}
							class:list={[{ large: !nested }, entry.attrs.class]}
							{...entry.attrs}
						>
							<span>{entry.label}</span>
							{entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
						</a>
					</li>
				);
			}
			const linked = linkedGroup(entry);
			if (linked) {
				// A group's own badge is Starlight's; a badge on the heading link is the fallback.
				const badge = entry.badge ?? linked.link.badge;
				return (
					<li class="linked">
						<a
							href={linked.link.href}
							aria-current={linked.link.isCurrent ? 'page' : undefined}
							class:list={['large', linked.link.attrs.class]}
							{...linked.link.attrs}
						>
							<span>{linked.link.label}</span>
							{badge && <Badge variant={badge.variant} class={badge.class} text={badge.text} />}
						</a>
						<details open={startsOpen(entry)}>
							<summary class="caret-only" aria-label={`Toggle ${linked.link.label}`}>
								<Icon name="right-caret" class="caret" size="1.25rem" />
							</summary>
							<SidebarRestorePoint />
							<Astro.self sublist={linked.entries} nested plainLabels />
						</details>
					</li>
				);
			}
			return (
				<li>
					<details open={startsOpen(entry)}>
						<summary>
							<span class="group-label">
								<span class:list={plainLabels ? 'plain-label' : 'large'}>{entry.label}</span>
								{entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
							</span>
							<Icon name="right-caret" class="caret" size="1.25rem" />
						</summary>
						<SidebarRestorePoint />
						<Astro.self sublist={entry.entries} nested plainLabels={plainLabels} />
					</details>
				</li>
			);
		})
	}
</ul>

<style>
	/* Starlight's SidebarSublist styles, plus the linked heading row and the plain label at the end. */
	@layer starlight.core {
		ul {
			--sl-sidebar-item-padding-inline: 0.5rem;
			list-style: none;
			padding: 0;
		}

		li {
			overflow-wrap: anywhere;
		}

		ul ul li {
			margin-inline-start: var(--sl-sidebar-item-padding-inline);
			border-inline-start: 1px solid var(--sl-color-hairline-light);
			padding-inline-start: var(--sl-sidebar-item-padding-inline);
		}

		.large {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.top-level > li + li {
			margin-top: 0.75rem;
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			cursor: pointer;
			user-select: none;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.caret {
			transition: transform 0.2s ease-in-out;
			flex-shrink: 0;
		}
		:global([dir='rtl']) .caret {
			transform: rotateZ(180deg);
		}
		[open] > summary .caret {
			transform: rotateZ(90deg);
		}

		a {
			display: block;
			border-radius: 0.25rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			padding: 0.3em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
		}

		a:hover,
		a:focus {
			color: var(--sl-color-white);
		}

		[aria-current='page'],
		[aria-current='page']:hover,
		[aria-current='page']:focus {
			font-weight: 600;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		a > *:not(:last-child),
		.group-label > *:not(:last-child) {
			margin-inline-end: 0.25em;
		}

		/* A linked heading: the link and the caret-only summary share the first
		   grid row, and the group's list fills the row below. The `<details>`
		   is `display: contents` so its summary and its content box are grid
		   items, and the browser still hides the content while the details is
		   closed. Browsers with `::details-content` wrap the content in that
		   box, so it spans both columns; where the pseudo-element doesn't
		   exist, the list itself is the grid item and spans them instead. */
		li.linked {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
		}
		li.linked > details {
			display: contents;
		}
		li.linked > details::details-content,
		li.linked > details > ul {
			grid-column: 1 / -1;
		}
		summary.caret-only {
			border-radius: 0.25rem;
		}
		/* The current-page accent paints the whole heading row: the link cell and the caret cell. */
		li.linked > a[aria-current='page'] {
			border-start-end-radius: 0;
			border-end-end-radius: 0;
		}
		li.linked > a[aria-current='page'] + details > summary.caret-only {
			border-start-start-radius: 0;
			border-end-start-radius: 0;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		/* A group label under a linked heading (a part, or a topic-map area)
		   reads as a child: same size and color as a lesson link. */
		.plain-label {
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-2);
		}

		@media (min-width: 50rem) {
			.top-level > li + li {
				margin-top: 0.5rem;
			}
			.large {
				font-size: var(--sl-text-base);
			}
			a,
			.plain-label {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
