---
// The virtual module, as in Starlight's own Sidebar, so a `components.MobileMenuFooter` override still applies.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
/**
 * Starlight `Sidebar` override. Renders Starlight's sidebar with our
 * `SidebarSublist` in place of the default one, so a course page and the topic
 * map are the headings of their groups (issue #228, `lib/sidebar-groups.ts`).
 * Then a client script adds a due review count next to each course link (spec
 * S05 "Where reviews surface"). The sidebar is static at build time, so the count is
 * drawn from the progress record on the client and redrawn on the progress
 * event. A course with nothing due has no count element. The style is in
 * `styles/custom.css` with the other sidebar rules.
 */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import { getAreas } from '@lib/areas';
import SidebarSublist from './SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

// The course list comes from the data tree on the server; the client script reads it from the attribute.
const courses = (await getAreas()).map((a) => ({ area: a.slug, title: a.name }));
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
<script is:inline type="application/json" data-sidebar-courses set:html={JSON.stringify(courses)} />

<script>
	import { dueByCourse, dueCountLabel } from '@scripts/due-counts';
	import * as progress from '@scripts/progress';

	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	const courses: { area: string; title: string }[] = JSON.parse(
		document.querySelector('[data-sidebar-courses]')?.textContent ?? '[]'
	);

	/** The course links in the sidebar. The count element exists only while something is due. */
	const links = new Map<string, HTMLAnchorElement>();
	for (const c of courses) {
		const link = document.querySelector<HTMLAnchorElement>(`.sidebar-content a[href="${base}/${c.area}/"]`);
		if (link) links.set(c.area, link);
	}

	function draw() {
		const due = new Map(dueByCourse(courses, progress.load(), progress.today()).map((c) => [c.area, c.due]));
		for (const [area, link] of links) {
			const n = due.get(area) ?? 0;
			let count = link.querySelector<HTMLElement>('[data-due-count]');
			if (n === 0) {
				count?.remove();
				continue;
			}
			if (!count) {
				count = document.createElement('span');
				count.className = 'due-count not-content';
				count.dataset.dueCount = area;
				link.appendChild(count);
			}
			const label = document.createElement('span');
			label.className = 'sr-only';
			label.textContent = dueCountLabel(n);
			count.replaceChildren(String(n), label);
		}
	}
	draw();
	document.addEventListener(progress.EVENT, draw);
</script>
