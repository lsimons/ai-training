---
/**
 * The settings page (spec S04 "learner" fields, spec S05 "frequency
 * control"): the comfort level, and the review schedule with a per-item
 * "See this sooner" / "See this less often". Nothing here changes content;
 * comfort changes routing and where new review items enter (spec S05).
 */
import { buildCatalog } from '@lib/catalog';

const catalog = await buildCatalog();
---

<div class="not-content settings" data-catalog={JSON.stringify(catalog)}>
	<h2 id="comfort">Comfort level</h2>
	<p>
		Applies to the Engineering lessons. It changes what the lesson suggests around the content, never the content itself.{' '}
		<em>Less comfortable</em> lists the sections a lesson builds on at its top, and puts new review items in your next
		session. <em>More comfortable</em> shows the extensions at the end of a lesson, and starts new review items at stage 2.
		Click the chosen level again to unset it.
	</p>
	<div class="comfort" role="group" aria-label="Comfort level">
		<button type="button" data-comfort="less" aria-pressed="false">less comfortable</button>
		<button type="button" data-comfort="more" aria-pressed="false">more comfortable</button>
		<span class="comfort-note" data-comfort-note></span>
	</div>

	<h2 id="review-schedule">Review schedule</h2>
	<p>
		Every checkpoint of a lesson you finished comes back for review at growing intervals: 1, 3, 7, 21, then 60 days. A pass
		moves an item up a stage; a fail drops it to stage 1. Nudge an item here if that pace is wrong for you.
	</p>
	<p class="schedule-due" data-due-now></p>
	<div class="review-schedule" data-schedule></div>
</div>

<script>
	import { mountSettings } from '@scripts/settings';

	mountSettings();
</script>
