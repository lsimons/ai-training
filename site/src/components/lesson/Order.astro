---
/** Put steps in sequence by dragging rows or with the arrows (spec S01 `order`). `steps` is the correct order; the page shuffles. */
import type { CheckpointPhase } from '@lib/checkpoint-rules';
import CheckpointShell from './CheckpointShell.astro';

interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	review?: boolean;
	revision?: number;
	/** `first` (default), `review` or `practice` (spec S03 "Checkpoint props"). */
	phase?: CheckpointPhase;
	steps: string[];
}
const { id, objective, title, hint, concepts, context, review, revision, steps, phase } = Astro.props;
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {review} {revision} {phase} kind="order">
	<slot />
	<Fragment slot="body">
		<ol class="cp-order" aria-label="Steps to order">
			{
				steps.map((s, i) => (
					<li data-pos={i + 1} draggable="true">
						<span class="cp-step">{s}</span>
						<span class="cp-move">
							<button type="button" data-move="up" aria-label={`Move "${s}" up`}>↑</button>
							<button type="button" data-move="down" aria-label={`Move "${s}" down`}>↓</button>
						</span>
					</li>
				))
			}
		</ol>
	</Fragment>
</CheckpointShell>
