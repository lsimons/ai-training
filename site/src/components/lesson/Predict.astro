---
/**
 * Predict the output of real code (spec S01 `predict`). With `answer`, the
 * page grades by comparison and `run` names the fixture CI executes to assert
 * that answer. Without `answer`, it is the honor-system variant: the learner
 * runs it themselves and self-grades.
 */
import CheckpointShell from './CheckpointShell.astro';

interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	answer?: string;
	run?: string;
	review?: boolean;
	revision?: number;
}
const { id, objective, title, hint, concepts, context, answer, run, review, revision } = Astro.props;
const honor = answer === undefined;
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {review} {revision} {honor} kind="predict" checkLabel={honor ? 'Record' : 'Check'}>
	<slot />
	<Fragment slot="body">
		<div data-answer={answer} data-run={run} class="cp-predict">
			<label>
				<span class="cp-label">{honor ? 'Your prediction' : 'What is printed?'}</span>
				<textarea rows={honor ? 3 : 1} spellcheck="false"></textarea>
			</label>
			{
				honor ? (
					<fieldset class="cp-selfgrade">
						<legend>After running it, how did your prediction hold up?</legend>
						<label><input type="radio" name={`${id}-selfgrade`} value="pass" /> It matched</label>
						<label><input type="radio" name={`${id}-selfgrade`} value="partial" /> Partly</label>
					</fieldset>
				) : (
					<pre class="cp-reveal" hidden>{answer}</pre>
				)
			}
			{run && <p class="cp-verified">Output verified in CI from <code>site/examples/{run}</code>.</p>}
			{!run && !honor && <p class="cp-verified">This example is not run in CI; the output was checked by hand.</p>}
		</div>
	</Fragment>
</CheckpointShell>
