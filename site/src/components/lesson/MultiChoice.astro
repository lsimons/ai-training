---
/**
 * Select exactly N correct items with no false positives (spec S01
 * `multi-choice`). Wrong picks show their own `why`; a missed correct item is
 * only counted, never named.
 */
import type { CheckpointPhase } from '@lib/checkpoint-rules';
import CheckpointShell from './CheckpointShell.astro';

interface Option {
	text: string;
	correct?: boolean;
	why?: string;
}
interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	review?: boolean;
	revision?: number;
	/** `first` (default), `review` or `practice` (spec S03 "Checkpoint props"). */
	phase?: CheckpointPhase;
	/** Opt-out from the guessability check, `"<cue>: reason"` (spec S03 "Checkpoints"). */
	guessable?: string;
	options: Option[];
}
const { id, objective, title, hint, concepts, context, review, revision, guessable, options, phase } = Astro.props;
const correct = options.filter((o) => o.correct).length;
if (correct < 2)
	throw new Error(`MultiChoice "${id}" needs at least two correct options, has ${correct}. Use Choice for one.`);
if (correct === options.length) throw new Error(`MultiChoice "${id}" needs at least one wrong option`);
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {review} {revision} {phase} {guessable} kind="multi-choice">
	<slot />
	<Fragment slot="body">
		<fieldset class="cp-options cp-multi" data-count={correct}>
			<legend>Select exactly {correct}.</legend>
			{
				options.map((o) => (
					<label data-correct={o.correct ? 'true' : undefined} data-why={o.why}>
						<input type="checkbox" name={`${id}-multi`} />
						<span>{o.text}</span>
					</label>
				))
			}
		</fieldset>
	</Fragment>
</CheckpointShell>
