---
/** Place chips into labeled buckets, click-to-select then click-a-bucket (spec S01 `sort`). */
import CheckpointShell from './CheckpointShell.astro';

interface Item {
	text: string;
	bucket: number;
}
interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	review?: boolean;
	revision?: number;
	buckets: string[];
	items: Item[];
}
const { id, objective, title, hint, review, revision, buckets, items } = Astro.props;
for (const it of items) {
	if (it.bucket < 0 || it.bucket >= buckets.length) throw new Error(`Sort "${id}": item "${it.text}" points at bucket ${it.bucket}`);
}
---

<CheckpointShell {id} {objective} {title} {hint} {review} {revision} kind="sort">
	<slot />
	<Fragment slot="body">
		<div class="cp-sort">
			<div class="cp-pool-wrap">
				<button type="button" class="cp-pool-target">Unplaced (select an item, then a bucket)</button>
				<div class="cp-pool">
					{
						items.map((it) => (
							<button type="button" class="cp-chip" data-bucket={it.bucket} aria-pressed="false">
								{it.text}
							</button>
						))
					}
				</div>
			</div>
			<div class="cp-buckets">
				{
					buckets.map((b, i) => (
						<div class="cp-bucket" data-bucket={i}>
							<button type="button" class="cp-bucket-target">{b}</button>
							<div class="cp-bucket-items"></div>
						</div>
					))
				}
			</div>
		</div>
	</Fragment>
</CheckpointShell>
