---
/** Single-select multiple choice. Wrong picks show their own `why` (spec S01 `choice`). */
import CheckpointShell from './CheckpointShell.astro';

interface Option {
	text: string;
	correct?: boolean;
	why?: string;
}
interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	review?: boolean;
	revision?: number;
	/** Opt-out from the surface-cue check with its reason (spec S03 "Checkpoints"). */
	guessable?: string;
	options: Option[];
}
const { id, objective, title, hint, concepts, context, review, revision, guessable, options } = Astro.props;
const correct = options.filter((o) => o.correct).length;
if (correct !== 1) throw new Error(`Choice "${id}" needs exactly one correct option, has ${correct}`);
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {review} {revision} {guessable} kind="choice">
	<slot />
	<Fragment slot="body">
		<div class="cp-options" role="radiogroup" aria-label={title}>
			{
				options.map((o) => (
					<label data-correct={o.correct ? 'true' : undefined} data-why={o.why}>
						<input type="radio" name={`${id}-choice`} />
						<span>{o.text}</span>
					</label>
				))
			}
		</div>
	</Fragment>
</CheckpointShell>
