---
/**
 * Assign one option to each statement row (spec S01 `match`). Each row is a
 * `<select>`, so it is keyboard operable without extra scripting. Per-row
 * feedback after Check, linked to the select with `aria-describedby` (the
 * shared `.cp-feedback` region does the announcing); `rationale` shows on
 * a full pass.
 */
import type { CheckpointPhase } from '@lib/checkpoint-rules';
import CheckpointShell from './CheckpointShell.astro';

interface Row {
	statement: string;
	/** Index into `options`. */
	option: number;
	/** Shown next to the row when it is wrong. Never the answer. */
	why?: string;
}
interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). */
	concepts: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	review?: boolean;
	revision?: number;
	/** `first` (default), `review` or `practice` (spec S03 "Checkpoint props"). */
	phase?: CheckpointPhase;
	options: string[];
	rows: Row[];
	/** Shown once every row is right. */
	rationale: string;
}
const { id, objective, title, hint, concepts, context, review, revision, options, rows, rationale, phase } =
	Astro.props;
if (rows.length < 2) throw new Error(`Match "${id}" needs at least two rows`);
for (const r of rows) {
	if (r.option < 0 || r.option >= options.length)
		throw new Error(`Match "${id}": row "${r.statement}" points at option ${r.option}`);
}
---

<CheckpointShell {id} {objective} {title} {hint} {concepts} {context} {review} {revision} {phase} kind="match">
	<slot />
	<Fragment slot="body">
		<div class="cp-match" data-rationale={rationale}>
			{
				rows.map((r, i) => (
					<div class="cp-match-row" data-option={r.option} data-why={r.why}>
						<label for={`${id}-row-${i}`}>{r.statement}</label>
						<select id={`${id}-row-${i}`} aria-describedby={`${id}-row-${i}-fb`}>
							<option value="">Choose…</option>
							{options.map((o, j) => (
								<option value={j}>{o}</option>
							))}
						</select>
						<span class="cp-row-feedback" id={`${id}-row-${i}-fb`}></span>
					</div>
				))
			}
		</div>
	</Fragment>
</CheckpointShell>
