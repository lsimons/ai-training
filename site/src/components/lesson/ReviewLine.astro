---
/**
 * The review line of a lesson that sets `review-by` (spec S03 "Frontmatter").
 * The MarkdownContent override renders it above the lesson body. Renders
 * nothing without a `reviewBy` date.
 */
import { isoDate, reviewLine } from '@lib/review-line';

interface Props {
	reviewBy?: Date | undefined;
	sourcesChecked?: Date | undefined;
}

const { reviewBy, sourcesChecked } = Astro.props;
const text = reviewLine(reviewBy, sourcesChecked);
---

{
	text && reviewBy && (
		<p class="lesson-review not-content" data-review-by={isoDate(reviewBy)}>
			{text}
		</p>
	)
}
