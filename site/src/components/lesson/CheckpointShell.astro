---
/**
 * Shared frame for every checkpoint kind (spec S03 "Checkpoints"): a section
 * whose id is the checkpoint id, a heading, the stem, the interaction, and the
 * Check / Hint / Skip controls. Review-only controls (Give up, the stage
 * pills) are rendered hidden and enabled by the review page. The review
 * frequency is adjusted on the settings page, not here.
 */
import { lessonIdOf } from '@lib/lesson-context';
import { href } from '@lib/url';
import { DEFAULT_REVISION, isReviewable, type CheckpointKind } from '@lib/checkpoint-rules';

interface Props {
	id: string;
	objective: string;
	title: string;
	hint: string;
	kind: CheckpointKind;
	/** Author opt-out from review (spec S05 "What is reviewed"). Default true. */
	review?: boolean;
	/** Bump when the answer changes; outdated review items reset to stage 1 (spec S05). Default 1. */
	revision?: number;
	/** Set by Predict when there is no `answer`: honor-system, never reviewed. */
	honor?: boolean;
	checkLabel?: string;
}

const { id, objective, title, hint, kind, review = true, revision = DEFAULT_REVISION, honor = false, checkLabel = 'Check' } = Astro.props;
if (!Number.isInteger(revision) || revision < 1) throw new Error(`Checkpoint "${id}": revision must be a positive integer, got ${revision}`);
const reviewable = isReviewable({ kind, review, honor });
const lessonId = lessonIdOf(Astro);
const progressId = `${lessonId}#${id}`;
---

<section
	class="checkpoint not-content"
	id={id}
	data-checkpoint
	data-kind={kind}
	data-progress-id={progressId}
	data-objective={objective}
	data-reviewable={String(reviewable)}
	data-revision={String(revision)}
	data-title={title}
>
	<header class="cp-head">
		<span class="cp-kind">Checkpoint · {kind}</span>
		<span class="cp-state" aria-live="polite"></span>
	</header>
	<h3 class="cp-title">{title}</h3>
	<div class="cp-stem"><slot /></div>
	<div class="cp-body"><slot name="body" /></div>
	<div class="cp-controls">
		<button type="button" class="cp-check">{checkLabel}</button>
		<button type="button" class="cp-hint-btn" aria-expanded="false">Hint</button>
		<button type="button" class="cp-skip">Skip</button>
		<button type="button" class="cp-giveup" hidden>Give up</button>
	</div>
	<p class="cp-hint" hidden>{hint}</p>
	<p class="cp-feedback" role="status" aria-live="polite"></p>
	<div class="cp-after" hidden>
		<a class="cp-lesson-link" href={href(`/${lessonId}/#${id}`)}>Open in the lesson</a>
		<span class="cp-stage" hidden>
			<span></span><span></span><span></span><span></span><span></span>
			<em class="cp-stage-label"></em>
		</span>
	</div>
</section>
