---
/**
 * The course page as a lesson graph (spec S02 "Course page as lesson graph"):
 * lesson nodes in levels, dotted edges from `assumes`, a milestone bar, a
 * completion ring, a review-due card and an about panel. Node state comes
 * from the progress record on the client.
 */
import { getCollection } from 'astro:content';
import { areaOf } from '@lib/areas';
import { dependenciesOf, getCoursePlan, isLive, planLevels } from '@lib/courses';
import { jsonForScript } from '@lib/json';
import { checkpointsOf } from '@lib/lessons';
import { href } from '@lib/url';

interface Props {
	area: string;
}
const { area } = Astro.props;
const info = areaOf(area);
// The plan (site/src/data/courses/<area>.yaml) decides which lessons the graph shows
// and where. Planned and drafting entries render as "coming" nodes without a link.
const plan = await getCoursePlan(area);
const lessons = plan.filter(isLive).map((e) => e.lesson);
const levels = planLevels(plan, area);
const maxLevel = Math.max(0, ...levels.values());
const rows = Array.from({ length: maxLevel + 1 }, (_, i) => plan.filter((e) => levels.get(e.id) === i));
// Only live lessons reach the client: progress never counts a coming lesson.
const nodes = lessons.map((l) => ({
	id: l.id,
	title: l.data.title,
	mode: l.data.mode,
	checkpoints: checkpointsOf(l).map((c) => ({ id: c.id, reviewable: c.reviewable, revision: c.revision })),
}));
const edges = plan.flatMap((e) => dependenciesOf(e, area).map((from) => ({ from, to: e.id })));
const coming = plan.length - lessons.length;

const competencies = (await getCollection('competencies')).find((c) => c.data.area === area)?.data.competencies ?? [];
const topics = await getCollection('topics');
const covered = new Set(lessons.flatMap((l) => l.data.covers ?? []));
const prerequisites = [
	...new Set(topics.filter((t) => covered.has(t.data.id)).flatMap((t) => t.data.links.prerequisites)),
]
	.filter((p) => !p.startsWith(`${area}/`))
	.map((p) => topics.find((t) => t.data.id === p))
	.filter((t): t is NonNullable<typeof t> => Boolean(t));
const totalCheckpoints = nodes.reduce((n, l) => n + l.checkpoints.length, 0);
---

<div class="course not-content" data-course={area} data-nodes={JSON.stringify(nodes)}>
	<div class="course-top">
		<div class="course-ring" data-ring style="--pct: 0" aria-label="Completion">
			<span data-ring-label>0%</span>
		</div>
		<div class="course-milestone" aria-label="Milestones">
			<div class="course-milestone-track"><div class="course-milestone-fill" data-milestone-fill></div></div>
			<ol class="course-milestone-stops">
				<li data-stop="0">getting started</li>
				<li data-stop="50">halfway</li>
				<li data-stop="80">almost there</li>
				<li data-stop="100">complete</li>
			</ol>
			<p class="course-skipped" data-skipped hidden></p>
		</div>
	</div>

	<div class="course-graph" data-graph>
		<svg class="course-edges" aria-hidden="true"></svg>
		{
			rows.map((row) => (
				<div class="course-level">
					{row.map((e) =>
						isLive(e) ? (
							<a class="course-node" href={href(`/${e.id}/`)} data-node={e.id} data-state="untouched">
								<span class="course-node-ring" data-node-ring style="--pct: 0"></span>
								<span class="course-node-body">
									<span class="course-node-mode">{e.lesson.data.mode}</span>
									<span class="course-node-title">{e.lesson.data.title}</span>
									<span class="course-node-count" data-node-count></span>
								</span>
							</a>
						) : (
							<span class="course-node" data-node={e.id} data-state="coming" aria-label={`${e.title} (coming)`}>
								<span class="course-node-ring" style="--pct: 0"></span>
								<span class="course-node-body">
									<span class="course-node-mode">coming</span>
									<span class="course-node-title">{e.title}</span>
									<span class="course-node-count">{e.status === 'drafting' ? 'being written' : 'planned'}</span>
								</span>
							</span>
						)
					)}
				</div>
			))
		}
		<script is:inline type="application/json" data-edges set:html={jsonForScript(edges)} />
	</div>

	<aside class="course-review" data-review-card data-due="false">
		<a href={href(`/${area}/review/`)} data-review-label>Review: nothing due yet</a>
	</aside>

	<aside class="course-about">
		<p class="course-about-title">About this course</p>
		<dl>
			<dt>Goals</dt>
			<dd>
				<ul>
					{competencies.map((c) => <li><a href={href(`/competencies/${c.id}/`)}>{c.statement}</a></li>)}
				</ul>
			</dd>
			<dt>Counts</dt>
			<dd>
				{lessons.length} lesson{lessons.length === 1 ? '' : 's'}, {totalCheckpoints} checkpoint{totalCheckpoints === 1 ? '' : 's'}{coming > 0 && <>, {coming} more coming</>}
			</dd>
			<dt>Builds on</dt>
			<dd>
				{prerequisites.length ? (
					<ul>
						{prerequisites.map((t) => <li><a href={href(`/topics/${t.data.id}/`)}>{t.data.name}</a></li>)}
					</ul>
				) : (
					<span>Nothing; start here.</span>
				)}
			</dd>
		</dl>
		<p class="course-about-note">{info.description} Progress is kept in this browser; see <a href={href('/progress/')}>your progress</a>.</p>
	</aside>
</div>

<script>
	import { progressPercent } from '@scripts/overview';
	import * as progress from '@scripts/progress';

	interface Node {
		id: string;
		checkpoints: { id: string; reviewable: boolean; revision: number }[];
	}

	document.querySelectorAll<HTMLElement>('.course[data-course]').forEach((root) => {
		const area = root.dataset.course!;
		const nodes: Node[] = JSON.parse(root.dataset.nodes!);
		// Items whose answer changed since they were scheduled restart at stage 1 (spec S05 "Content changes").
		progress.resetOutdatedReviews(
			nodes.flatMap((n) => n.checkpoints.filter((c) => c.reviewable).map((c) => ({ id: `${n.id}#${c.id}`, revision: c.revision })))
		);

		function draw() {
			const rec = progress.load();
			for (const n of nodes) {
				const l = rec.lessons[n.id];
				// The node ring is within-lesson detail (passed / this lesson's checkpoints), not a progress unit.
				const passed = n.checkpoints.filter((c) => rec.checkpoints[`${n.id}#${c.id}`]?.state === 'passed').length;
				const state = l?.state === 'finished' ? 'finished' : l?.state === 'skipped' ? 'skipped' : l?.state === 'read' ? 'in-progress' : 'untouched';
				const el = root.querySelector<HTMLElement>(`[data-node="${n.id}"]`);
				if (!el) continue;
				el.dataset.state = state;
				const ring = el.querySelector<HTMLElement>('[data-node-ring]');
				if (ring) ring.style.setProperty('--pct', String(n.checkpoints.length ? Math.round((passed / n.checkpoints.length) * 100) : 0));
				const count = el.querySelector<HTMLElement>('[data-node-count]');
				if (count) count.textContent = n.checkpoints.length ? `${passed}/${n.checkpoints.length} checkpoints` : '';
			}
			// Milestone bar and completion ring show the one figure from spec S04 "Progress display":
			// finished / (all − skipped) lessons. The ring is the compact form of the same number.
			const { percent, skipped } = progressPercent(
				nodes.map((n) => n.id),
				rec
			);
			const fill = root.querySelector<HTMLElement>('[data-milestone-fill]');
			if (fill) fill.style.width = `${percent}%`;
			root.querySelectorAll<HTMLElement>('[data-stop]').forEach((s) => (s.dataset.reached = String(percent >= Number(s.dataset.stop) && (percent > 0 || s.dataset.stop === '0'))));
			const ring = root.querySelector<HTMLElement>('[data-ring]');
			if (ring) ring.style.setProperty('--pct', String(percent));
			const label = root.querySelector<HTMLElement>('[data-ring-label]');
			if (label) label.textContent = `${percent}%`;
			const skippedEl = root.querySelector<HTMLElement>('[data-skipped]');
			if (skippedEl) {
				skippedEl.textContent = `${skipped} skipped`;
				skippedEl.hidden = skipped === 0;
			}
			// Review card: always linked; counts every due item, not just one session's worth.
			const due = progress.dueReviewIds(rec, `${area}/`);
			const card = root.querySelector<HTMLElement>('[data-review-card]');
			if (card) card.dataset.due = String(due.length > 0);
			const reviewLabel = root.querySelector<HTMLElement>('[data-review-label]');
			if (reviewLabel) reviewLabel.textContent = due.length ? `Review due: ${due.length} item${due.length === 1 ? '' : 's'}` : 'Review: nothing due yet';
		}

		/** Dotted edges from the lesson that teaches an assumed objective to the lesson assuming it. */
		function drawEdges() {
			const svg = root.querySelector<SVGSVGElement>('.course-edges');
			const graph = root.querySelector<HTMLElement>('[data-graph]');
			const raw = root.querySelector('[data-edges]')?.textContent;
			if (!svg || !graph || !raw) return;
			const edges: { from: string; to: string }[] = JSON.parse(raw);
			const box = graph.getBoundingClientRect();
			svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			svg.innerHTML = edges
				.map((e) => {
					const a = root.querySelector(`[data-node="${e.from}"]`)?.getBoundingClientRect();
					const b = root.querySelector(`[data-node="${e.to}"]`)?.getBoundingClientRect();
					if (!a || !b) return '';
					const x1 = a.left + a.width / 2 - box.left, y1 = a.bottom - box.top;
					const x2 = b.left + b.width / 2 - box.left, y2 = b.top - box.top;
					return `<path d="M${x1},${y1} C${x1},${(y1 + y2) / 2} ${x2},${(y1 + y2) / 2} ${x2},${y2}" />`;
				})
				.join('');
		}

		draw();
		drawEdges();
		document.addEventListener(progress.EVENT, draw);
		window.addEventListener('resize', drawEdges);
	});
</script>
